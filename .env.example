# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Everything below is optional when working against the local `hardhat` / `localhost` network:
# the scripts fall back to documented throwaway keys there and warn about it.

# --- Network -----------------------------------------------------------------
# JSON-RPC endpoint used by the `sepolia` network.
SEPOLIA_RPC_URL=

# Ethereum mainnet endpoint. Only needed for the fork tests in test/fork, which verify the
# swapper against the real Uniswap V3. They are skipped when this is unset.
MAINNET_RPC_URL=

# Deploys the contracts and sends the transactions. Needs testnet ETH.
DEPLOYER_PRIVATE_KEY=

# Used by `npx hardhat verify`.
ETHERSCAN_API_KEY=

# --- Paymaster ---------------------------------------------------------------
# The key whose EIP-712 signature authorizes a sponsorship. In production this lives in a
# sponsorship service and never touches a deployment machine.
PAYMASTER_SIGNER_PRIVATE_KEY=

# Amount of ETH deposited into the EntryPoint for the paymaster by
# `scripts/deploy.ts` and `scripts/deposit-paymaster.ts`.
PAYMASTER_DEPOSIT_ETH=0.05

# --- Smart account -----------------------------------------------------------
# The key that owns the smart account and signs its UserOperations.
ACCOUNT_OWNER_PRIVATE_KEY=

# Distinguishes several accounts belonging to the same owner.
ACCOUNT_SALT=0

# --- ERC-20 settlement (optional) --------------------------------------------
# A non-zero rate makes send-sponsored-user-op.ts charge the account in ERC-20
# instead of sponsoring the operation outright. Fee tokens per 1e18 wei of gas.
FEE_EXCHANGE_RATE=0

# Fee token address. On a local chain the mock deployed by deploy.ts is used when unset.
FEE_TOKEN=

# Uniswap V3 pool fee tier used to convert the collected fee into the paymaster's canonical
# token. Leave at 0 to keep the fee token as it is. The local demo pool uses 500.
FEE_POOL_FEE=0
