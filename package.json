    "clean": "hardhat clean",
    "node": "hardhat node",
    "deploy": "hardhat run scripts/deploy.ts",
    "create-account": "hardhat run scripts/create-account.ts",
    "deposit": "hardhat run scripts/deposit-paymaster.ts",
    "send-user-op": "hardhat run scripts/send-sponsored-user-op.ts",
    "format": "prettier --write \"**/*.{ts,sol,json,md}\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@nomicfoundation/hardhat-ignition-viem": "^3.0.7",
    "@nomicfoundation/hardhat-keystore": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.0",
    "@nomicfoundation/hardhat-node-test-runner": "^3.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-verify": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@nomicfoundation/hardhat-viem-assertions": "^3.0.5",
    "@nomicfoundation/ignition-core": "^3.0.7",
    "@types/node": "^22.10.0",
    "dotenv": "^17.0.0",
    "hardhat": "^3.12.0",
    "prettier": "^3.4.0",
    "prettier-plugin-solidity": "^2.0.0",
    "typescript": "~5.8.0",
    "viem": "^2.55.10"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.8.0",
